# ==========================================
# DocBD Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production

# PostgreSQL Database with PostGIS
DATABASE_URL=postgresql://docbd_admin:StrongSecretPassword2026!@localhost:5432/docbd_prod?schema=public

# Telco SMS Gateway (ssl_wireless / infobip / greenweb / mock)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key
SMS_SID=DOCBD_MASKING
SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# bKash Payment Gateway Credentials (Optional)
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
